{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowJs": false,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "types": []
  },
  "include": ["lib", "astro", "nextjs-app", "nextjs-pages", "index.ts"],
  "exclude": ["node_modules"]
}
